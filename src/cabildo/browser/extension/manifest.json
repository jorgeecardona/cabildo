{
  "manifest_version": 3,
  "name": "cabildo",
  "version": "0.0.1",
  "description": "Lets your local cabildo agents use the tabs you put in the \"cabildo\" tab group.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "cabildo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
