#!/usr/bin/env bash
# cabildo pre-commit -- fast, runs on every commit.
# Activated via `make install-hooks` (sets core.hooksPath=.githooks).
# Bypass with `git commit --no-verify`.
#
# Two jobs only (the test suite is deferred to pre-push to keep commits quick):
#   1. Auto-bump the patch version when the shipped Python source (src/**/*.py)
#      changes, so __version__ in src/cabildo/__init__.py -- the single source of
#      truth (pyproject reads it via [tool.hatch.version]) -- advances with every
#      code change. Doc/notes (incl. src/*.md)/test/example/config-only commits do not bump.
#   2. Lint the staged Python with ruff (the same linter CI runs).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# 1. auto-bump patch when the shipped Python source changed -- src/**/*.py only,
#    so any notes/docs that ever push under src/ don't trigger a release.
#    (The version is dynamic, so only src/cabildo/__init__.py moves -- uv.lock is untouched.)
if printf '%s\n' "${staged[@]}" | grep -qE '^src/.*\.py$'; then
    # ...unless __version__ is already moving in this commit. `make bump TYPE=minor`
    # followed by a commit that also touches src/ would otherwise bump twice: once by
    # hand, once here. That silently skips a version (0.1.1 -> 0.1.2 -> 0.1.3), and worse,
    # it turns a deliberate `TYPE=minor` into a minor+patch. The invariant this hook
    # actually wants is "the version moved", not "this hook moved it".
    if git diff --cached -- src/cabildo/__init__.py | grep -qE '^\+__version__ = "'; then
        echo "pre-commit: version already bumped in this commit -- leaving it alone"
    else
        ./scripts/bump-version patch
        git add src/cabildo/__init__.py
    fi
fi

# 1b. bump the cabildo-push plugin version when its files change. `claude plugin
#     update` (run by `cabildo install`) is a no-op on an unchanged version, so a
#     mod change without a bump never reaches the plugin cache.
plugin_json=mods/plugins/cabildo-push/.claude-plugin/plugin.json
if printf '%s\n' "${staged[@]}" | grep -qE '^mods/plugins/cabildo-push/' \
    && ! git diff --cached -- "$plugin_json" | grep -qE '^\+.*"version"'; then
    python3 - "$plugin_json" <<'PY'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
major, minor, patch = (int(x) for x in d["version"].split("."))
d["version"] = f"{major}.{minor}.{patch + 1}"
open(p, "w").write(json.dumps(d, indent=2) + "\n")
print(f"pre-commit: cabildo-push plugin -> {d['version']}")
PY
    git add "$plugin_json"
fi

# 2. lint staged Python (fast; pyright + tests run in pre-push)
mapfile -t py < <(printf '%s\n' "${staged[@]}" | grep -E '\.py$' || true)
if [[ ${#py[@]} -gt 0 ]]; then
    uv run ruff check "${py[@]}"
fi
