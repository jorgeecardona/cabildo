{
  "name": "cabildo",
  "displayName": "cabildo",
  "description": "The cabildo panel in the side bar: your Claude conversations, their model, context, limits and cost, and your unread messages.",
  "version": "0.0.7",
  "publisher": "cardona-oss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/cardona-oss/cabildo.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "files": [
    "out/src",
    "media",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cabildo.new",
        "title": "New Claude Session in Folder",
        "category": "Cabildo",
        "icon": "$(add)"
      },
      {
        "command": "cabildo.attach",
        "title": "Attach to Claude Session",
        "category": "Cabildo"
      },
      {
        "command": "cabildo.refresh",
        "title": "Refresh",
        "category": "Cabildo",
        "icon": "$(refresh)"
      },
      {
        "command": "cabildo.openMessage",
        "title": "Open Message",
        "category": "Cabildo"
      },
      {
        "command": "cabildo.reply",
        "title": "Reply",
        "category": "Cabildo",
        "icon": "$(reply)"
      },
      {
        "command": "cabildo.markRead",
        "title": "Mark Read",
        "category": "Cabildo",
        "icon": "$(check)"
      },
      {
        "command": "cabildo.markAllRead",
        "title": "Mark All Read",
        "category": "Cabildo",
        "icon": "$(check-all)"
      }
    ],
    "configuration": {
      "title": "cabildo",
      "properties": {
        "cabildo.command": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path of the `cabildo` program. Empty: use the Python that runs the cabildo daemon, else `cabildo` on `PATH`."
        },
        "cabildo.openIn": {
          "type": "string",
          "enum": ["console", "terminal"],
          "enumDescriptions": [
            "The cabildo console view, in the bottom panel unless you move it.",
            "A VS Code terminal tab that runs `cabildo attach`."
          ],
          "default": "console",
          "description": "Where a session of the session host opens."
        },
        "cabildo.refreshSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "Seconds between status bar updates."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "cabildo-console",
          "title": "cabildo",
          "icon": "media/cabildo.svg"
        }
      ],
      "activitybar": [
        {
          "id": "cabildo",
          "title": "cabildo",
          "icon": "media/cabildo.svg"
        }
      ]
    },
    "views": {
      "cabildo-console": [
        {
          "type": "webview",
          "id": "cabildo.console",
          "name": "Console"
        }
      ],
      "cabildo": [
        {
          "type": "webview",
          "id": "cabildo.panel",
          "name": "Panel"
        },
        {
          "id": "cabildo.messages",
          "name": "Unread Messages",
          "when": "cabildo.hasUnread",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cabildo.openMessage",
          "when": "false"
        },
        {
          "command": "cabildo.reply",
          "when": "false"
        },
        {
          "command": "cabildo.markRead",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "cabildo.new",
          "when": "view == cabildo.panel",
          "group": "navigation@1"
        },
        {
          "command": "cabildo.refresh",
          "when": "view == cabildo.panel",
          "group": "navigation@2"
        },
        {
          "command": "cabildo.markAllRead",
          "when": "view == cabildo.messages",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cabildo.reply",
          "when": "viewItem == message",
          "group": "inline@1"
        },
        {
          "command": "cabildo.markRead",
          "when": "viewItem == message",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node vendor.mjs && tsc -p .",
    "test": "rm -rf out && pnpm run build && node --test \"out/test/*.test.js\"",
    "package": "pnpm run test && vsce package --no-dependencies --out cabildo.vsix",
    "probe": "pnpm run build && node probe/run.mjs"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@vscode/vsce-sign"
    ]
  },
  "devDependencies": {
    "@types/node": "~22.20.7",
    "@types/vscode": "~1.108.0",
    "@vscode/vsce": "4.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "7.0.2"
  }
}
